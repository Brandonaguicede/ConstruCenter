# Supabase Frontend Configuration
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Supabase Backend (solo Vercel Serverless, NUNCA usar prefijo VITE_)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Vercel Serverless / Cloudflare R2 Storage (Backend)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=construcenter-bucket
R2_PUBLIC_DOMAIN=https://pub-your-id.r2.dev

# Resend Email Configuration (Backend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=ventas@tudominio.com

# Admin Notifications WhatsApp Phone
ADMIN_WHATSAPP_NUMBER=521234567890
